<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!-- Doi Data Source neu dung SQL Server khac, vi du .\SQLEXPRESS -->
  <connectionStrings>
    <add name="QLNhaThuoc"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=QLNhaThuoc;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
