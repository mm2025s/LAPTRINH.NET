<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!--
    Lab 07 - IT3212 - Cau hinh ung dung.

    BAI 8: Chuoi ket noi duoc dat o day (KHONG hard-code trong ma nguon).
           Ma nguon doc qua ConfigurationManager.ConnectionStrings["QLSinhVien"].
           Xem DAL/DbConnectionFactory.cs.

    CACH THAY CHUOI KET NOI theo moi truong (sua thuoc tinh connectionString):

      * LocalDB (SQL Server Express LocalDB - mac dinh tren may demo):
          Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=QLSinhVien;Integrated Security=True

      * SQL Server Express (ten instance mac dinh):
          Data Source=.\SQLEXPRESS;Initial Catalog=QLSinhVien;Integrated Security=True

      * SQL Server 2019/2022 (instance mac dinh "."):
          Data Source=.;Initial Catalog=QLSinhVien;Integrated Security=True

      * SQL Authentication (tai khoan ung dung - bai 7):
          Data Source=.\SQLEXPRESS;Initial Catalog=QLSinhVien;User ID=app_qlsv;Password=MatKhau@123

    Sau khi sua, chay lai ung dung va bam "Kiem tra ket noi".
  -->
  <connectionStrings>
    <add name="QLSinhVien"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=QLSinhVien;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
