{
  // Cấu hình chạy/gỡ lỗi (debug) cho VS Code.
  // Nhấn F5 để chạy, hoặc bấm biểu tượng ▶ ở panel Run and Debug.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chạy Lab01 (Debug)",
      "type": "coreclr",
      "request": "launch",

      // Chạy task build trước khi khởi động debug.
      "preLaunchTask": "build-lab01",

      // Đường dẫn tới file .dll sau khi biên dịch.
      // Nếu sau này đổi TargetFramework trong .csproj, nhớ sửa cả dòng này.
      "program": "${workspaceFolder}/bin/Debug/net8.0/Lab01_Console.dll",

      "args": [],
      "cwd": "${workspaceFolder}",

      // Bắt buộc dùng integratedTerminal để Console.ReadLine() nhận được
      // dữ liệu anh gõ vào (nếu dùng internalConsole sẽ không nhập được).
      "console": "integratedTerminal",

      // true: dừng ngay tại dòng đầu tiên khi bắt đầu chạy.
      "stopAtEntry": false,

      // Tự mở terminal và focus vào đó để anh nhập dữ liệu.
      "internalConsoleOptions": "neverOpen",

      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Chạy Lab01 (không debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-lab01",
      "program": "${workspaceFolder}/bin/Debug/net8.0/Lab01_Console.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
