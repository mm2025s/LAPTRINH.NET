{
  "version": "2.0.0",
  "tasks": [
    {
      // Task này được launch.json gọi tự động trước khi debug.
      "label": "build-lab01",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Lab01_Console.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      // Chạy nhanh không cần debug: Ctrl+Shift+B hoặc Terminal > Run Task
      "label": "run-lab01",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/Lab01_Console.csproj"
      ],
      "problemMatcher": "$msCompile",
      "dependsOn": "build-lab01"
    },
    {
      // Dọn dẹp thư mục build khi cần
      "label": "clean-lab01",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/Lab01_Console.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
